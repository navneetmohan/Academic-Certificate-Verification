# ==============================================================================
# Blockchain Academic Certificate Verification - Environment Configuration
# ==============================================================================
# WARNING: NEVER commit production private keys or sensitive credentials!
# The keys below are standard, publicly-known Hardhat local development accounts.

# Database Connection (SQLite default for zero-friction local execution, or PostgreSQL)
DATABASE_URL=sqlite:///./certificates.db
# DATABASE_URL=postgresql://certuser:certpassword@localhost:5432/certdb

# Blockchain RPC Connection (Default Hardhat node running on port 8545)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# Deployed AcademicCertificateRegistry Smart Contract Address
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Authorized University Issuer Account (Hardhat Default Account #1)
DEFAULT_INSTITUTION_WALLET=0x70997970C51812dc3A010C7d01b50e0d17dc79C8
ISSUER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# Seed Institution Admin Credentials
DEFAULT_INSTITUTION_EMAIL=admin@university.edu
DEFAULT_INSTITUTION_PASSWORD=adminpassword123

# Security: JWT Token Secret Key
JWT_SECRET=super-secret-academic-certificate-verification-jwt-key-2026

# Storage Paths & URLs
CERTIFICATE_STORAGE_PATH=./certificates
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000/api
